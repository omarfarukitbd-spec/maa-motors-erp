rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasUserDoc() && getUserData().get('role', '') == 'Admin';
    }

    function isBoss() {
      return hasUserDoc() && getUserData().get('role', '') == 'Boss';
    }

    function getPerms() {
      return hasUserDoc() ? getUserData().get('permissions', {}) : {};
    }

    // By default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (isAdmin() || (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'permissions'])));
      allow delete: if isAdmin();
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isAdmin() || (!isBoss() && getPerms().get('manageCustomers', false) == true));
      allow delete: if isAdmin();
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (isAdmin() || isBoss() || getPerms().get('viewExpenses', false) == true);
      allow create, update, delete: if isAuthenticated() && (isAdmin() || (!isBoss() && getPerms().get('manageExpenses', false) == true));
    }

    // Transactions Collection
    match /transactions/{txnId} {
      allow read: if isAuthenticated() && (isAdmin() || isBoss() || getPerms().get('manageLedger', false) == true || getPerms().get('viewReports', false) == true);
      allow create, update, delete: if isAuthenticated() && (isAdmin() || (!isBoss() && getPerms().get('manageLedger', false) == true));
    }

    // Zones Collection
    match /zones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || (!isBoss() && getPerms().get('manageCustomers', false) == true));
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    // Settings
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Bank Accounts
    match /bank_accounts/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || (!isBoss() && getPerms().get('manageLedger', false) == true));
    }

    // Cash Collectors
    match /cash_collectors/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || (!isBoss() && getPerms().get('manageLedger', false) == true));
    }

    // Bank Transactions
    match /bank_transactions/{docId} {
      allow read: if isAuthenticated() && (isAdmin() || isBoss() || getPerms().get('manageLedger', false) == true || getPerms().get('viewReports', false) == true);
      allow write: if isAuthenticated() && (isAdmin() || (!isBoss() && getPerms().get('manageLedger', false) == true));
    }
  }
}
