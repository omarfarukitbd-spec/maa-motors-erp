// -------------------------------------------------------------------------
// 🛠️ EXPORTED FUNCTIONS (Hoisted)
// -------------------------------------------------------------------------

export async function login() {
    const e = document.getElementById('email-input')?.value, p = document.getElementById('password-input')?.value, err = document.getElementById('login-error');
    if(!e || !p) return err ? err.innerText = "ইমেইল ও পাসওয়ার্ড দিন!" : null;
    try {
        await auth.signInWithEmailAndPassword(e, p);
    } catch (error) {
        if(err) err.innerText = "লগইন ব্যর্থ! সঠিক তথ্য দিন।";
        console.error("Login error:", error);
    }
}

export async function loginWithGoogle() {
    const errEl = document.getElementById('login-error');
    if (errEl) errEl.innerText = "গুগল লগইন প্রসেস করা হচ্ছে...";
    try {
        await auth.signInWithPopup(googleProvider);
    } catch (e) {
        console.warn("Google Popup Auth failed, attempting redirect:", e);
        try {
            await auth.signInWithRedirect(googleProvider);
        } catch(err) {
            console.error("Google Auth error:", err);
            if (errEl) errEl.innerText = "গুগল লগইন ব্যর্থ! ইমেইল/পাসওয়ার্ড দিয়ে চেষ্টা করুন।";
        }
    }
}

export function logout() {
    const user = firebase.auth().currentUser;
    if (user) auditLog('LOGOUT', 'Auth', user.uid, user.email);
    auth.signOut();
    const ls = document.getElementById('login-screen'), ac = document.getElementById('app-container');
    if(ls) ls.style.display = 'flex';
    if(ac) ac.classList.add('hidden');
    ['nav-admin', 'nav-audit'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
    });
}

export function navigate(view, params = {}) {
    if (AppState.currentView === 'dashboard' && view !== 'dashboard') unsubscribeDashboard();
    if (AppState.currentView === 'audit' && view !== 'audit') unsubscribeAuditLogs();
    
    AppState.currentView = view;
    const sidebar = document.getElementById('app-sidebar');
    if(sidebar) sidebar.classList.remove('open');

    document.querySelectorAll('.nav-links li, .nav-item').forEach(li => {
        li.classList.remove('active');
        if(li.getAttribute('onclick')?.includes(`'${view}'`)) li.classList.add('active');
    });

    const container = document.getElementById('view-container');
    if(!container) return;

    if(view === 'dashboard') renderDashboard(container, params);
    else if(view === 'customers') renderCustomers(container);
    else if(view === 'ledger') renderLedger(container, params);
    else if(view === 'bulk') renderBulkEntry(container);
    else if(view === 'invoice') renderInvoice(container, params);
    else if(view === 'expenses') renderExpenses(container);
    else if(view === 'settings') renderSettings(container);
    else if(view === 'statement') renderStatement(container, params);
    else if(view === 'admin') renderAdmin(container);
    else if(view === 'audit') renderAuditLogs(container);

    setTimeout(initDatePickers, 50);
}

function unlockApp() {
    initCustomerCache();
    const errEl = document.getElementById('login-error');
    if (errEl) errEl.innerText = '';
    const ls = document.getElementById('login-screen'), ac = document.getElementById('app-container');
    if(ls) ls.style.display = 'none';
    if(ac) ac.classList.remove('hidden');

    const roleEl = document.getElementById('user-role');
    if(roleEl) roleEl.innerText = AppState.currentUserRole || 'User';

    const currentUser = firebase.auth().currentUser;
    const avatarEl = document.getElementById('user-profile-avatar');
    if (avatarEl && currentUser) {
        if (currentUser.photoURL) {
            avatarEl.innerHTML = `<img src="${currentUser.photoURL}" alt="${currentUser.displayName || 'User'}" class="w-full h-full object-cover rounded-full" referrerpolicy="no-referrer" />`;
        } else {
            avatarEl.innerHTML = `<i class="fa-solid fa-user-shield text-sm"></i>`;
        }
        avatarEl.title = `${currentUser.email} (${AppState.currentUserRole})`;
    }

    navigate(AppState.currentView || 'dashboard');
}

// -------------------------------------------------------------------------
// 🚀 GLOBAL BINDINGS (EARLY)
// -------------------------------------------------------------------------
window.app = {
    login,
    loginWithGoogle,
    logout,
    toggleSidebar: () => document.getElementById('app-sidebar')?.classList.toggle('open'),
    toggleSidebarCollapse: () => {
        const sb = document.getElementById('app-sidebar');
        if(sb) {
            sb.classList.toggle('collapsed');
            localStorage.setItem('sidebarCollapsed', sb.classList.contains('collapsed'));
        }
    },
    toggleCalculator: () => document.getElementById('calculator-widget')?.classList.toggle('hidden')
};
window.navigate = navigate;

// -------------------------------------------------------------------------
// 🔐 AUTH LISTENER
// -------------------------------------------------------------------------
let userStatusUnsubscribe = null;

auth.onAuthStateChanged(async (user) => {
    if (userStatusUnsubscribe) { userStatusUnsubscribe(); userStatusUnsubscribe = null; }

    if (user) {
        userStatusUnsubscribe = UserDAO.listenUser(user.uid, async (userData) => {
            let finalUserData = userData;
            if(!userData) {
                const lowerEmail = user.email?.toLowerCase().trim() || '';
                const isAdmin = lowerEmail === 'office.maamotors@gmail.com' || lowerEmail === 'maamotorsbd@gmail.com';
                finalUserData = {
                    email: user.email, name: user.displayName || user.email.split('@')[0],
                    role: isAdmin ? 'Admin' : 'Staff', status: isAdmin ? 'active' : 'pending',
                    pin: '', createdAt: firebase.firestore.FieldValue.serverTimestamp()
                };
                await UserDAO.getRef(user.uid).set(finalUserData);
                return;
            }

            AppState.currentUserRole = finalUserData.role || 'Staff';
            AppState.currentUserEmail = finalUserData.email || user.email;
            AppState.permissions = finalUserData.permissions || {};

            if (finalUserData.status === 'active') {
                hideWaitingRoom();
                const ac = document.getElementById('app-container');
                if (ac && ac.classList.contains('hidden')) {
                    if (AppState.currentUserRole === 'Admin') {
                        ['nav-admin', 'nav-audit'].forEach(id => document.getElementById(id)?.classList.remove('hidden'));
                        auditLog('LOGIN', 'Auth', user.uid, user.email, { role: 'Admin' });
                        unlockApp();
                    } else {
                        const { value: pin } = await Swal.fire({
                            title: 'অ্যাক্সেস পিন দিন', input: 'password', allowOutsideClick: false,
                            showCancelButton: true, cancelButtonText: 'লগআউট'
                        });
                        if(pin === finalUserData.pin && pin) {
                            auditLog('LOGIN', 'Auth', user.uid, user.email, { role: 'Staff' });
                            unlockApp();
                        } else { auth.signOut(); }
                    }
                }
            } else if (finalUserData.status === 'pending') {
                showWaitingRoom(user.email);
            } else {
                auth.signOut();
                if(document.getElementById('login-error')) document.getElementById('login-error').innerText = "Account Blocked";
            }
        });
    } else {
        logout();
        hideWaitingRoom();
    }
});

function showWaitingRoom(email) {
    if (document.getElementById('waiting-room')) return;
    const wr = document.createElement('div');
    wr.id = 'waiting-room';
    wr.className = 'fixed inset-0 z-[100] flex items-center justify-center bg-slate-950/80 backdrop-blur-md p-4 font-bn';
    wr.innerHTML = `<div class="w-full max-w-[420px] p-8 m3-card text-center border-blue-500/30">
        <div class="w-20 h-20 bg-amber-500/10 text-amber-500 text-4xl flex items-center justify-center rounded-3xl mx-auto mb-6 animate-pulse"><i class="fa-solid fa-hourglass-half"></i></div>
        <h2 class="text-2xl font-black text-white mb-2">অনুমোদনের অপেক্ষায়...</h2>
        <p class="text-slate-400 text-sm font-bold mb-6">${email} Pending অবস্থায় আছে।</p>
        <button class="text-slate-500 hover:text-red-400 text-xs font-bold" onclick="app.logout()">লগআউট</button>
    </div>`;
    document.body.appendChild(wr);
}
function hideWaitingRoom() { document.getElementById('waiting-room')?.remove(); }

