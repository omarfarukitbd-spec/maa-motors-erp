// ... Keep Search and Flatpickr logic (Omitted for brevity in prompt, but I will write them) ...
// Actually I MUST write the full file to avoid data loss.
// I will copy the search and flatpickr logic from the previous read.

let searchDebounce;
function initSearch() {
    const input = document.getElementById('global-search-input'), results = document.getElementById('global-search-results');
    if(!input || !results) return;
    input.oninput = (e) => {
        const query = e.target.value.trim();
        if(query.length < 1) return results.classList.add('hidden');
        clearTimeout(searchDebounce);
        searchDebounce = setTimeout(async () => {
            results.classList.remove('hidden');
            results.innerHTML = '<div class="p-4 text-xs text-slate-500 text-center">অনুসন্ধান করা হচ্ছে...</div>';
            performSearch(query, results);
        }, 150);
    };
}

async function performSearch(query, container) {
    try {
        let html = '';
        const q = query.toLowerCase();
        const customers = getCustomerCache().filter(c => (c.name||'').toLowerCase().includes(q) || (c.phone||'').includes(q) || (c.accountNo||'').includes(q));
        if(customers.length > 0) {
            html += `<div class="px-3 py-1 bg-slate-800 text-[10px] text-blue-400">কাস্টমার (${customers.length})</div>`;
            customers.forEach(c => {
                html += `<div class="p-3 hover:bg-slate-800 cursor-pointer flex justify-between items-center border-b border-slate-800" onclick="handleSearchResultClick('customer', '${c.id}', '${c.name}', '${c.accountNo||''}')">
                    <div><div class="font-bold text-white text-sm">${c.name}</div><div class="text-xs text-slate-400">${c.phone||''}</div></div>
                    <div class="text-xs font-bold text-red-400">৳${formatAmountWithComma(c.totalDue||0)}</div>
                </div>`;
            });
        }
        container.innerHTML = html || '<div class="p-4 text-xs text-slate-500">কিছু পাওয়া যায়নি</div>';
    } catch (e) { container.innerHTML = 'Error'; }
}

window.handleSearchResultClick = (type, id, name, accNo) => {
    document.getElementById('global-search-results')?.classList.add('hidden');
    if(type === 'customer') navigate('statement', { customerId: id, customerName: name, accountNo: accNo });
};

// ─── Global Flatpickr DD/MM/YYYY Enforcer ───────────────────────────────────
export function initDatePickers() {
    document.querySelectorAll('input.datepicker').forEach(input => {
        if(input._flatpickr) return;
        flatpickr(input, {
            dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', allowInput: true,
            onChange: (selectedDates, dateStr) => {
                input.value = dateStr;
                input.dispatchEvent(new Event('change', { bubbles: true }));
            }
        });
    });
}
window.initDatePickers = initDatePickers;

document.addEventListener('DOMContentLoaded', () => {
    initSearch(); initDatePickers();
    if (localStorage.getItem('sidebarCollapsed') === 'true') document.getElementById('app-sidebar')?.classList.add('collapsed');

    const btns = ['7','8','9','/','4','5','6','*','1','2','3','-','C','0','.','+','='];
    const container = document.getElementById('calc-buttons');
    if(container) container.innerHTML = btns.map(b => `<button onclick="handleCalc('${b}')" class="p-4 bg-slate-700 text-white rounded-xl font-bold hover:bg-slate-600">${b}</button>`).join('');
});

function safeEvalCalc(expression) {
    try { return eval(expression.replace(/[^0-9+\-*/.]/g, '')); } catch { return 'Error'; }
}
window.handleCalc = (v) => {
    const d = document.getElementById('calc-display'); if(!d) return;
    if(v === 'C') d.value = '';
    else if(v === '=') d.value = safeEvalCalc(d.value);
    else d.value += v;
};
