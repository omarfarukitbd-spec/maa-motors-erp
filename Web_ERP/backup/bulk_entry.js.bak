    const tabSpreadsheet = document.getElementById('tab-spreadsheet');
    const tabExcel = document.getElementById('tab-excel');
    const tabAdminExcel = document.getElementById('tab-admin-excel');
    
    if(tabSpreadsheet) tabSpreadsheet.className = tab === 'spreadsheet' ? 'px-6 py-2 text-sm font-semibold rounded-lg bg-blue-600 text-white shadow-md' : 'px-6 py-2 text-sm font-semibold rounded-lg text-slate-400 hover:text-white hover:bg-slate-700/50';
    if(tabExcel) tabExcel.className = tab === 'excel' ? 'px-6 py-2 text-sm font-semibold rounded-lg bg-blue-600 text-white shadow-md' : 'px-6 py-2 text-sm font-semibold rounded-lg text-slate-400 hover:text-white hover:bg-slate-700/50';
    if(tabAdminExcel) tabAdminExcel.className = tab === 'admin-excel' ? 'px-6 py-2 text-sm font-semibold rounded-lg bg-emerald-600 text-white shadow-md' : 'px-6 py-2 text-sm font-semibold rounded-lg text-emerald-400 border border-emerald-500/30 bg-emerald-500/10 hover:bg-emerald-500/20';

