// --- Bulk / Fast Entry Module ---
import Swal from 'sweetalert2';
import { db, firebase } from './firebase-config.js';
import { CustomerDAO, TransactionDAO, SettingsDAO } from './dao.js';
import { parseAmount, formatAmountWithComma, toDBDate } from './utils.js';
import { getCustomerCache, initCustomerCache } from './customer/index.js';
import { auditLog } from './audit.js';

export function renderBulkEntry(container) {
    if (window.AppState?.currentUserRole === 'Staff' && window.AppState?.permissions?.viewBulkEntry === false) {
        container.innerHTML = `<div class="m3-card text-center font-bn py-12"><h2 class="text-xl font-black text-red-500">অ্যাক্সেস ডিনাইড! আপনার ফাস্ট এন্ট্রি (Bulk Entry) ব্যবহারের অনুমতি নেই।</h2></div>`;
        return;
    }

    const isAdmin = window.AppState?.currentUserRole === 'Admin';
    const adminTabBtn = isAdmin ? `
        <button class="px-6 py-2 text-sm font-semibold rounded-lg transition-all text-emerald-400 border border-emerald-500/30 bg-emerald-500/10 hover:bg-emerald-500/20" id="tab-admin-excel" onclick="switchBulkTab('admin-excel')">
            <i class="fa-solid fa-file-excel mr-1"></i> স্মার্ট এক্সেল (Admin Only)
        </button>
    ` : '';

    container.innerHTML = `
        <div class="flex flex-col gap-6">
            <div class="px-2">
                <h2 class="text-2xl font-bold flex items-center gap-4 tracking-tight text-white font-bn">
                    <div class="w-1.5 h-8 bg-blue-600 rounded-full shadow-[0_0_15px_rgba(59,130,246,0.4)]"></div>
                    ফাস্ট এন্ট্রি (Bulk Entry)
                </h2>
            </div>

            <div class="flex flex-wrap gap-2 p-1 bg-slate-800/50 border border-slate-700/50 rounded-xl self-start ml-2 font-bn">
                <button class="px-6 py-2 text-sm font-semibold rounded-lg transition-all" id="tab-spreadsheet" onclick="switchBulkTab('spreadsheet')">স্প্রেডশিট গ্রিড</button>
                <button class="px-6 py-2 text-sm font-semibold rounded-lg transition-all" id="tab-excel" onclick="switchBulkTab('excel')">এক্সেল আপলোড</button>
                ${adminTabBtn}
            </div>

            <div id="bulk-content-area" class="m3-card">
                <!-- Content changes based on tab -->
            </div>
        </div>
    `;
    loadCustomerDatalist();
    switchBulkTab('spreadsheet');
}

async function loadCustomerDatalist() {
    try {
        let customers = getCustomerCache();
        if (!customers || customers.length === 0) {
            initCustomerCache();
            customers = await CustomerDAO.getAll();
        }
        let listEl = document.getElementById('customer-datalist');
        if (!listEl) {
            listEl = document.createElement('datalist');
            listEl.id = 'customer-datalist';
            document.body.appendChild(listEl);
        }
        let optsHtml = '';
        customers.forEach(c => {
            const acc = c.accountNo ? `[${c.accountNo}] ` : '';
            const phone = c.phone ? ` (${c.phone})` : '';
            optsHtml += `<option value="${acc}${c.name}${phone}">${acc}${c.name}</option>`;
        });
        listEl.innerHTML = optsHtml;
    } catch(e) { console.error("Error loading customer datalist:", e); }
}

