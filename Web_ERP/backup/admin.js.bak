            <!-- System Utilities & Account No Manager -->
            <div class="m3-card space-y-5 border-l-4 border-l-blue-500">
                <div class="border-b border-slate-700 pb-3">
                    <h3 class="font-black flex items-center gap-2.5 text-white text-base">
                        <div class="w-8 h-8 rounded-xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400">
                            <i class="fa-solid fa-gears text-sm"></i>
                        </div>
                        সিস্টেম ইউটিলিটি ও আইডি ম্যানেজার
