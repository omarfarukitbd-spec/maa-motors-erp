import Swal from 'sweetalert2';
import { db, firebase } from './firebase-config.js';
import { ExpenseDAO } from './dao.js';
import { parseAmount, formatAmountWithComma, formatAppDate, toDBDate } from './utils.js';
import { AppState } from './state.js';
import { auditLog } from './audit.js';

let editingExpenseId = null;

// Pagination State for Expenses
let lastVisibleExp = null;
let pageStackExp = [];
let currentExpPage = 1;
const expPageSize = 20;

function escapeHTML(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}

let expensesUnsubscribe = null;

export function renderExpenses(container) {
    if(window.AppState.currentUserRole === 'Staff' && window.AppState.permissions.viewExpenses === false) {
        container.innerHTML = `<div class="m3-card text-center"><h2 class="text-xl font-bold text-red-500 font-bn">অ্যাক্সেস ডিনাইড! আপনার দৈনিক খরচ দেখার অনুমতি নেই।</h2></div>`;
        return;
    }

    if (expensesUnsubscribe) expensesUnsubscribe();

    // Reset pagination state
    lastVisibleExp = null;
    pageStackExp = [];
    currentExpPage = 1;

    container.innerHTML = `
        <div class="flex flex-col gap-6 font-bn">
            <div class="px-2">
                <h2 class="text-2xl font-black text-white flex items-center gap-4 tracking-tight">
                    <div class="w-1.5 h-8 bg-blue-600 rounded-full shadow-[0_0_15px_rgba(59,130,246,0.4)]"></div> 
                    দৈনিক খরচ (Daily Expenses)
                    <button class="w-8 h-8 rounded-full hover:bg-slate-800 flex items-center justify-center text-slate-500 hover:text-blue-400 transition-all active:rotate-180" onclick="window.loadRecentExpenses()" title="রিফ্রেশ">
                        <i class="fa-solid fa-rotate text-sm"></i>
                    </button>
                </h2>
            </div>
            
            <div class="m3-card">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 items-end font-bn">
                    <div>
                        <label class="block text-[11px] font-black text-blue-400 mb-1.5 uppercase tracking-widest ml-1">তারিখ *</label>
                        <input type="text" id="exp-date" class="m3-field h-[42px] py-0 cursor-pointer text-sm datepicker">
                    </div>
                    <div>
                        <label class="block text-[11px] font-black text-blue-400 mb-1.5 uppercase tracking-widest ml-1">ক্যাটাগরি *</label>
                        <select id="exp-category" class="m3-field h-[42px] py-0 cursor-pointer font-bold text-sm" onchange="window.handleCategoryChange()"></select>
                    </div>
                    <div>
                        <label class="block text-[11px] font-black text-red-400 mb-1.5 uppercase tracking-widest ml-1">পরিমাণ (৳) *</label>
                        <input type="text" id="exp-amount" inputmode="decimal" placeholder="০.০০" oninput="window.handleNumberInput(this); updateLiveWords(this, 'exp-amount-words');" class="m3-field h-[42px] py-0 text-base font-black text-red-400 border-red-500/30 focus:border-red-500">
                        <div id="exp-amount-words" class="text-[11px] md:text-xs font-black text-red-400 mt-1.5 px-2 py-0.5 rounded-lg bg-red-500/10 border border-red-500/20 hidden italic inline-block"></div>
                    </div>
                    <div>
                        <label class="block text-[11px] font-black text-slate-300 mb-1.5 uppercase tracking-widest ml-1">খরচের বিবরণ (ঐচ্ছিক)</label>
                        <input type="text" id="exp-details" placeholder="বিবরণ লিখুন..." class="m3-field h-[42px] py-0 text-sm">
                    </div>
                    <div>
                        <button id="save-exp-btn" class="m3-btn-primary px-6 h-[42px] py-0 text-sm font-black uppercase tracking-widest w-full flex items-center justify-center gap-2" onclick="window.saveExpense()">
                            <i class="fa-solid fa-cloud-arrow-up text-sm"></i> সেভ করুন
                        </button>
                    </div>
                </div>
            </div>

            <div class="m3-table-container">
                <table class="m3-table min-w-[750px] w-full">
                    <thead>
                        <tr class="font-bn">
                            <th class="w-[140px]">তারিখ</th>
                            <th class="w-[180px]">ক্যাটাগরি</th>
                            <th>খরচের বিবরণ</th>
                            <th class="w-[150px] text-right">পরিমাণ</th>
                            <th class="w-[100px] text-center">অ্যাকশন</th>
                        </tr>
                    </thead>
                    <tbody id="expense-list" class="font-bn"></tbody>
                </table>
            </div>

            <!-- Pagination Controls -->
            <div id="expense-pagination" class="flex items-center justify-center gap-4 py-4 font-bn hidden">
                <button id="exp-prev-page" class="px-4 py-2 bg-slate-800 text-slate-300 rounded-xl border border-slate-700 hover:bg-slate-700 disabled:opacity-30 disabled:pointer-events-none transition-all" onclick="changeExpensePage('prev')">
                    <i class="fa-solid fa-chevron-left mr-2"></i> পূর্ববর্তী
                </button>
                <div class="text-white font-bold bg-blue-600/10 border border-blue-500/30 px-4 py-2 rounded-xl">
                    পৃষ্ঠা: <span id="exp-current-page-display">1</span>
                </div>
                <button id="exp-next-page" class="px-4 py-2 bg-slate-800 text-slate-300 rounded-xl border border-slate-700 hover:bg-slate-700 disabled:opacity-30 disabled:pointer-events-none transition-all" onclick="changeExpensePage('next')">
                    পরবর্তী <i class="fa-solid fa-chevron-right ml-2"></i>
                </button>
            </div>
        </div>`;

    document.getElementById('exp-date').value = (window.getTodayLocalDateString ? window.getTodayLocalDateString() : new Date().toISOString().split('T')[0]);
    loadExpenseCategories(); 
    loadRecentExpenses();
}

async function loadExpenseCategories() {
    const sel = document.getElementById('exp-category'); if(!sel) return;
    const cats = [
        "দোকান ভাড়া", "বিদ্যুৎ বিল", "পানি বিল", "ইন্টারনেট/ডিস বিল", "স্টাফ বেতন", 
        "নাস্তা/আপ্যায়ন", "চা/কফি", "যাতায়াত/পরিবহন", "মালামাল/পণ্য ক্রয়", "প্রিন্টিং/স্টেশনারি", 
        "মেরামতি/রক্ষণাবেক্ষণ", "দান/চাঁদা", "পৌরসভা/ট্যাক্স", "কুরিয়ার/পার্সেল", "অন্যান্য"
    ];
    sel.innerHTML = cats.map(c => `<option value="${c}">${c}</option>`).join('') + `<option value="ADD_NEW">+ নতুন ক্যাটাগরি যোগ করুন...</option>`;
}

window.handleCategoryChange = async function() {
    const sel = document.getElementById('exp-category');
    if (sel.value === 'ADD_NEW') {
        const { value: newCat } = await Swal.fire({
            title: 'নতুন ক্যাটাগরি যোগ করুন',
            input: 'text',
            inputPlaceholder: 'ক্যাটাগরির নাম লিখুন',
            showCancelButton: true,
            confirmButtonText: 'যোগ করুন',
            cancelButtonText: 'বাতিল',
            customClass: { popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700' }
        });
        if (newCat && newCat.trim()) {
            const trimmedCat = newCat.trim();
            const opt = document.createElement('option');
            opt.value = trimmedCat;
            opt.text = trimmedCat;
            sel.insertBefore(opt, sel.lastChild);
            sel.value = trimmedCat;
        } else {
            sel.selectedIndex = 0;
        }
    }
}

async function saveExpense() {
    const dateEl = document.getElementById('exp-date');
    const catEl = document.getElementById('exp-category');
    const detEl = document.getElementById('exp-details');
    const amtEl = document.getElementById('exp-amount');

    if (!dateEl || !catEl || !amtEl) return;

    const d = toDBDate(dateEl.value);
    const c = catEl.value;
    const det = detEl.value.trim();
    const a = parseAmount(amtEl.value);

    if(!a || a <= 0) return Swal.fire({
        title: 'ত্রুটি!',
        text: 'সঠিক খরচের পরিমাণ লিখুন',
        icon: 'error',
        customClass: { popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700' }
    });

    const btn = document.getElementById('save-exp-btn');
    if(btn) btn.disabled = true;

    // --- Data Verification Preview ---
    const words = numberToBanglaWords(a);
    const isEdit = !!editingExpenseId;

    const confirmPreview = await Swal.fire({
        title: isEdit ? '🔍 খরচ সংশোধন যাচাই' : '🔍 খরচ যাচাই করুন',
        html: `
            <div class="text-left space-y-3 font-bn p-2 bg-slate-900 rounded-2xl border border-slate-800">
                <div class="flex flex-col gap-1 border-b border-slate-800 pb-2">
                    <span class="text-[10px] text-blue-400 font-black uppercase tracking-widest">খরচের ক্যাটাগরি</span>
                    <span class="text-lg text-white font-black">${c}</span>
                </div>
                <div class="grid grid-cols-2 gap-4 border-b border-slate-800 pb-2">
                    <div class="flex flex-col gap-1">
                        <span class="text-[10px] text-blue-400 font-black uppercase tracking-widest">তারিখ</span>
                        <span class="text-sm text-slate-200 font-bold">${formatAppDate(d)}</span>
                    </div>
                    <div class="flex flex-col gap-1">
                        <span class="text-[10px] text-slate-400 font-black uppercase tracking-widest">বিবরণ</span>
                        <span class="text-xs text-slate-300 font-medium">${det || '-'}</span>
                    </div>
                </div>
                <div class="flex flex-col gap-1 pt-1">
                    <span class="text-[10px] text-red-400 font-black uppercase tracking-widest">খরচের পরিমাণ (৳)</span>
                    <span class="text-2xl text-red-500 font-black">৳ ${formatAmountWithComma(a)}</span>
                    ${words ? `<div class="text-[11px] text-red-400 font-black italic bg-red-500/10 px-2 py-1 rounded-lg border border-red-500/20 mt-1">(${words})</div>` : ''}
                </div>
            </div>
            <p class="text-[11px] text-amber-500 font-bold mt-4 text-center">খরচটি কি ${isEdit ? 'আপডেট' : 'সেভ'} করবেন?</p>
        `,
        showCancelButton: true,
        confirmButtonText: isEdit ? '✅ আপডেট করুন' : '✅ সেভ করুন',
        cancelButtonText: '❌ সংশোধন করব',
        customClass: {
            popup: '!bg-slate-950 !text-white !rounded-3xl border border-slate-700 shadow-2xl',
            confirmButton: 'm3-btn-primary !bg-blue-600 !px-8',
            cancelButton: 'm3-btn-tonal !px-6'
        }
    });

    if (!confirmPreview.isConfirmed) {
        if (btn) btn.disabled = false;
        return;
    }
    // --- End Preview ---

    try {
        if (editingExpenseId) {
            await ExpenseDAO.update(editingExpenseId, {
                date: d, category: c, details: det, amount: a
            });
            auditLog('UPDATE', 'Expenses', editingExpenseId, c, { date: d, amount: a, details: det });
            editingExpenseId = null;
            if(btn) {
                btn.innerHTML = '<i class="fa-solid fa-cloud-arrow-up text-sm"></i> সেভ করুন';
                btn.className = "m3-btn-primary px-6 h-[42px] py-0 text-sm font-black uppercase tracking-widest w-full flex items-center justify-center gap-2";
            }
        } else {
            const id = await ExpenseDAO.add({
                date: d, 
                category: c, 
                details: det, 
                amount: a, 
                createdBy: AppState.currentUserEmail || 'Unknown'
            });
            auditLog('CREATE', 'Expenses', id, c, { date: d, amount: a, details: det });
        }

        amtEl.value = ''; 
        detEl.value = '';
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: 'খরচ রেকর্ড সম্পন্ন হয়েছে! ✅',
            showConfirmButton: false,
            timer: 2000,
            customClass: { popup: '!bg-slate-900 !text-white border border-slate-700' }
        });

        // Reset to first page to see the new/updated entry
        lastVisibleExp = null;
        pageStackExp = [];
        currentExpPage = 1;
        loadRecentExpenses();
    } catch(e) {
        console.error("Save expense error:", e);
        Swal.fire('Error', 'খরচ সেভ করতে সমস্যা হয়েছে', 'error');
    } finally {
        if(btn) btn.disabled = false;
    }
}

async function loadRecentExpenses(direction = 'next') {
    if (expensesUnsubscribe) expensesUnsubscribe();

    const tbody = document.getElementById('expense-list');
    if(!tbody) return;

    tbody.innerHTML = '<tr><td colspan="5" class="text-center py-12"><i class="fa-solid fa-spinner fa-spin mr-3 text-blue-500 text-xl"></i> লোডিং...</td></tr>';

    try {
        const cursor = (direction === 'next') ? lastVisibleExp : (pageStackExp.length > 1 ? pageStackExp[pageStackExp.length - 2] : null);

        const results = await ExpenseDAO.getByPage(expPageSize, cursor, 'createdAt', 'desc');

        lastVisibleExp = results.lastDoc;
        if (direction === 'next') {
            if (cursor) pageStackExp.push(cursor);
        } else {
            pageStackExp.pop();
        }

        const paginationEl = document.getElementById('expense-pagination');
        if (paginationEl) {
            paginationEl.classList.remove('hidden');
            document.getElementById('exp-current-page-display').innerText = currentExpPage;
            document.getElementById('exp-prev-page').disabled = currentExpPage === 1;
            document.getElementById('exp-next-page').disabled = results.count < expPageSize;
        }

        renderExpenseRows(results.data, tbody);
    } catch (err) {
        console.error("Load expenses error:", err);
        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-12 text-red-400">ডাটা লোড করতে সমস্যা হয়েছে</td></tr>';
    }
}

function renderExpenseRows(expenses, tbody) {
    let html = '';
    expenses.forEach(d => {
        const isAdmin = String(window.AppState?.currentUserRole || '').toLowerCase() === 'admin';
        const canManage = isAdmin || window.AppState?.permissions?.manageExpenses === true;
        const safeDetails = encodeURIComponent(d.details || '');
        const safeCat = String(d.category || '').replace(/'/g, "\\'");
        const safeDate = String(d.date || '');
        const amountVal = Number(d.amount) || 0;

        const actionBtn = canManage ? `<td class="text-center">
            <div class="flex items-center justify-center gap-3">
                <button class="text-blue-400 hover:text-blue-300 p-1 cursor-pointer" title="এডিট" onclick="window.editExpense('${d.id}', '${safeDate}', '${safeCat}', ${amountVal}, '${safeDetails}')"><i class="fa-solid fa-pen-to-square"></i></button>
                <button class="text-red-400 hover:text-red-300 p-1 cursor-pointer" title="ডিলেট" onclick="window.deleteExpense('${d.id}', '${safeCat}')"><i class="fa-solid fa-trash"></i></button>
            </div>
        </td>` : '<td></td>';

        const escapedCat = escapeHTML(d.category);
        const escapedDetails = d.details ? `<span class="text-xs text-slate-200 font-medium">${escapeHTML(d.details)}</span>` : '<span class="text-slate-500 italic text-xs">-</span>';

        html += `
            <tr class="border-b border-slate-800/50 hover:bg-white/[0.02] transition-colors">
                <td class="text-slate-300 font-bold text-xs">
                    ${formatAppDate(d.date)}
                    ${d.createdBy ? `<div class="text-[9px] text-blue-400/80 font-sans italic mt-0.5" style="text-transform: none;">by ${escapeHTML(d.createdBy)}</div>` : ''}
                </td>
                <td class="font-bold text-white text-sm">${escapedCat}</td>
                <td>${escapedDetails}</td>
                <td class="text-right text-red-400 font-black text-base">৳${formatAmountWithComma(amountVal)}</td>
                ${actionBtn}
            </tr>
        `;
    });

    tbody.innerHTML = html || '<tr><td colspan="5" class="text-center py-10 text-slate-400 italic">কোনো ডাটা পাওয়া যায়নি</td></tr>';
}

window.changeExpensePage = (dir) => {
    if (dir === 'next') currentExpPage++;
    else currentExpPage--;
    loadRecentExpenses(dir);
};

async function deleteExpense(id, desc) {
    const isAdmin = String(window.AppState?.currentUserRole || '').toLowerCase() === 'admin';
    const canManage = isAdmin || window.AppState?.permissions?.manageExpenses === true;
    if (!canManage) {
        return Swal.fire('অ্যাক্সেস ডিনাইড!', 'আপনার খরচ মোছার অনুমতি নেই।', 'error');
    }
    const isPinValid = await window.promptSecurityPin("খরচ মুছে ফেলা (Delete)");
    if (!isPinValid) return;

    try {
        await ExpenseDAO.delete(id);
        auditLog('DELETE', 'Expenses', id, desc);

        // Refresh current page
        loadRecentExpenses();

        Swal.fire({
            title: 'সফল! ✅',
            text: 'খরচ সফলভাবে মুছে ফেলা হয়েছে।',
            icon: 'success',
            customClass: { popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700' }
        });
    } catch(err) {
        console.error("Delete expense error:", err);
        Swal.fire('Error', 'খরচ মুছতে সমস্যা হয়েছে: ' + (err.message || err), 'error');
    }
}

window.editExpense = async function(id, date, category, amount, detailsEncoded) {
    const isAdmin = String(window.AppState?.currentUserRole || '').toLowerCase() === 'admin';
    const canManage = isAdmin || window.AppState?.permissions?.manageExpenses === true;
    if (!canManage) {
        return Swal.fire('অ্যাক্সেস ডিনাইড!', 'আপনার খরচ মডিফাই করার অনুমতি নেই।', 'error');
    }
    const isPinValid = await window.promptSecurityPin("খরচ সংশোধন (Edit)");
    if (!isPinValid) return;

    if (window.AppState?.currentView !== 'expense' && window.navigate) {
        window.navigate('expense');
        await new Promise(r => setTimeout(r, 200));
    }

    const details = decodeURIComponent(detailsEncoded || '');
    const dateEl = document.getElementById('exp-date');
    if (dateEl) dateEl.value = formatAppDate(date) || '';

    const sel = document.getElementById('exp-category');
    if (sel) {
        if (!Array.from(sel.options).some(o => o.value === category)) {
            const opt = document.createElement('option');
            opt.value = category; opt.text = category;
            sel.insertBefore(opt, sel.lastChild);
        }
        sel.value = category;
    }

    const amtEl = document.getElementById('exp-amount');
    if (amtEl) amtEl.value = amount || '';

    const detEl = document.getElementById('exp-details');
    if (detEl) detEl.value = details || '';

    editingExpenseId = id;
    const btn = document.getElementById('save-exp-btn');
    if(btn) {
        btn.innerHTML = '<i class="fa-solid fa-pen-to-square text-sm"></i> আপডেট খরচ';
        btn.className = "m3-btn-primary px-6 h-[42px] py-0 text-sm font-black uppercase tracking-widest w-full flex items-center justify-center gap-2 !bg-amber-600 hover:!bg-amber-500 shadow-amber-600/30";
    }

    Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'info',
        title: '✏️ খরচ এডিট মোড চালু হয়েছে',
        text: 'সংশোধন শেষে "আপডেট খরচ" বাটনে ক্লিক করুন।',
        showConfirmButton: false,
        timer: 4000,
        customClass: { popup: '!bg-slate-900 !text-white border border-slate-700' }
    });

    window.scrollTo({ top: 0, behavior: 'smooth' });
}

window.saveExpense = saveExpense;
window.deleteExpense = deleteExpense;
window.loadRecentExpenses = loadRecentExpenses;

