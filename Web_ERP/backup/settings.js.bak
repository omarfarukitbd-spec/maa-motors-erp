// Load Settings from Firestore
async function loadSettings() {
    try {
        const data = await SettingsDAO.getAppSettings();
        if (Object.keys(data).length > 0) {
            if (data.shopLogo) {
                currentLogoBase64 = data.shopLogo;
                const preview = document.getElementById('logo-preview');
                if (preview) {
                    preview.src = currentLogoBase64;
                    preview.classList.remove('hidden');
                }
            }
            if(document.getElementById('set-shop-name')) document.getElementById('set-shop-name').value = data.shopName || '';
            if(document.getElementById('set-shop-phone')) document.getElementById('set-shop-phone').value = data.shopPhone || '';
            if(document.getElementById('set-shop-address')) document.getElementById('set-shop-address').value = data.shopAddress || '';
            if(document.getElementById('set-print-size')) document.getElementById('set-print-size').value = data.printSize || 'a4';
            
            if(document.getElementById('set-sms-new-bill')) document.getElementById('set-sms-new-bill').value = data.smsTemplateNew || 'Thank you for your purchase of Tk [Bill]. Your current due is Tk [Due]. We appreciate your business! - [Shop]';
            if(document.getElementById('set-sms-payment')) document.getElementById('set-sms-payment').value = data.smsTemplatePaid || 'We have received your payment of Tk [Paid]. Your updated due is Tk [Due]. Thank you for staying with us! - [Shop]';
            if(document.getElementById('set-sms-reminder')) document.getElementById('set-sms-reminder').value = data.smsTemplateReminder || 'Gentle Reminder: Your total due is Tk [Due]. Kindly clear the payment at your earliest convenience. Thank you! - [Shop]';
            
            checkSmsLength(document.getElementById('set-sms-new-bill'), 'sms-new-count');
            checkSmsLength(document.getElementById('set-sms-payment'), 'sms-pay-count');
            checkSmsLength(document.getElementById('set-sms-reminder'), 'sms-rem-count');

            if(document.getElementById('set-sms-api')) document.getElementById('set-sms-api').value = data.smsApiKey || '';
            if(document.getElementById('set-sms-sender')) document.getElementById('set-sms-sender').value = data.smsSenderId || '';
            if(document.getElementById('set-sms-auto')) document.getElementById('set-sms-auto').checked = data.smsAuto === true;
            if(document.getElementById('set-show-watermark')) document.getElementById('set-show-watermark').checked = data.showWatermark === true;
            
            const pinInp = document.getElementById('set-admin-pin');
            if (pinInp) pinInp.value = data.adminSecurityPin || '1060';
        } else {
            // Default Values if no settings saved yet
            if(document.getElementById('set-shop-name')) document.getElementById('set-shop-name').value = 'মেসার্স মা মোটরস্';
            if(document.getElementById('set-shop-phone')) document.getElementById('set-shop-phone').value = '01819-397669, 01815-707934';
            if(document.getElementById('set-shop-address')) document.getElementById('set-shop-address').value = 'রহমান টাওয়ার, দোকান নং-২২, ১নং রেল গেইট মুরাদপুর, হাটহাজারী রোড, চট্টগ্রাম।';
            if(document.getElementById('set-print-size')) document.getElementById('set-print-size').value = 'a4';
            if(document.getElementById('set-show-watermark')) document.getElementById('set-show-watermark').checked = false;
            
            const pinInp = document.getElementById('set-admin-pin');
            if (pinInp) pinInp.value = '1060';

            if(document.getElementById('set-sms-new-bill')) document.getElementById('set-sms-new-bill').value = 'Thank you for your purchase of Tk [Bill]. Your current due is Tk [Due]. We appreciate your business! - [Shop]';
            if(document.getElementById('set-sms-payment')) document.getElementById('set-sms-payment').value = 'We have received your payment of Tk [Paid]. Your updated due is Tk [Due]. Thank you for staying with us! - [Shop]';
            if(document.getElementById('set-sms-reminder')) document.getElementById('set-sms-reminder').value = 'Gentle Reminder: Your total due is Tk [Due]. Kindly clear the payment at your earliest convenience. Thank you! - [Shop]';
            
            checkSmsLength(document.getElementById('set-sms-new-bill'), 'sms-new-count');
            checkSmsLength(document.getElementById('set-sms-payment'), 'sms-pay-count');
            checkSmsLength(document.getElementById('set-sms-reminder'), 'sms-rem-count');
        }
    } catch(error) {
        console.error("Error loading settings:", error);
    }
}

// Toggle PIN Visibility
window.togglePinVisibility = function() {
    const el = document.getElementById('set-admin-pin');
    const icon = document.getElementById('pin-vis-icon');
    if (!el || !icon) return;
    if (el.type === 'password') {
        el.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
    } else {
        el.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
    }
};

// Seamless 2-step Security PIN Change Workflow
window.changeAdminSecurityPinFlow = async function() {
    if (window.AppState.currentUserRole !== 'Admin') {
        return Swal.fire('অ্যাক্সেস ডিনাইড!', 'শুধুমাত্র অ্যাডমিন সিকিউরিটি পিন পরিবর্তন করতে পারবেন।', 'error');
    }

    // Step 1: Verify current PIN
    const isPinValid = await promptSecurityPin("সিকিউরিটি পিন পরিবর্তন");
    if (!isPinValid) return;

    // Step 2: Prompt for new PIN
    const { value: newPin } = await Swal.fire({
        title: '🔑 নতুন এডমিন সিকিউরিটি পিন দিন',
        html: `<p style="color:#94a3b8;font-size:13px;margin-bottom:12px;">নতুন পিনটি কমপক্ষে ৪-ডিজিটের হতে হবে।</p>`,
        input: 'text',
        inputPlaceholder: 'e.g. 5678',
        inputAttributes: {
            autocomplete: 'new-password',
            autocapitalize: 'off',
            spellcheck: 'false'
        },
        showCancelButton: true,
        confirmButtonText: 'সেভ করুন',
        cancelButtonText: 'বাতিল',
        confirmButtonColor: '#2563eb',
        customClass: {
            popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700',
            title: '!text-white',
            confirmButton: 'm3-btn-primary !bg-blue-600',
            cancelButton: 'm3-btn-tonal'
        },
        inputValidator: (val) => {
            if (!val || val.trim().length < 4) {
                return 'সিকিউরিটি পিন কমপক্ষে ৪ ডিজিট বা তার বেশি হতে হবে!';
            }
        }
    });

    if (newPin) {
        const cleanPin = newPin.trim();
        try {
            await SettingsDAO.updateAppSettings({ adminSecurityPin: cleanPin });
            
            // Audit Log
            auditLog('PIN_CHANGE', 'Settings', 'appSettings', 'Admin Master PIN');

            // Update input field
            const el = document.getElementById('set-admin-pin');
            if (el) el.value = cleanPin;

            Swal.fire({
                title: '✅ সিকিউরিটি পিন সফলভাবে আপডেট হয়েছে!',
                html: `<p style="color:#38bdf8;font-[Outfit];font-size:16px;font-weight:bold;margin-top:8px;">নতুন পিন: ${cleanPin}</p><p style="color:#94a3b8;font-size:12px;margin-top:4px;">এখন থেকে যেকোনো তথ্য এডিট/ডিলেট করতে এই নতুন পিনটি ব্যবহার করুন।</p>`,
                icon: 'success',
                customClass: { popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700' }
            });
        } catch(err) {
            console.error("Failed to update security PIN:", err);
            Swal.fire({
                title: 'Error!',
                text: 'সিকিউরিটি পিন সেভ করতে সমস্যা হয়েছে: ' + (err.message || err),
                icon: 'error',
                customClass: { popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700' }
            });
        }
    }
};

// Check SMS Length & Unicode Threshold
window.checkSmsLength = function(element, counterId) {
    if(!element) return;
    const val = element.value || '';
    const len = val.length;
    const isUnicode = /[^\x00-\x7F]/.test(val);
    const limit = isUnicode ? 70 : 160;
    const parts = Math.ceil(len / limit) || 1;

    const counter = document.getElementById(counterId);
    if(counter) {
        counter.innerText = `${len}/${limit} (${parts} SMS${isUnicode ? ' - বাংলা' : ''})`;
        if(parts > 1) {
            counter.classList.add('text-amber-400');
            counter.classList.remove('text-purple-300');
        } else {
            counter.classList.remove('text-amber-400');
            counter.classList.add('text-purple-300');
        }
    }
};

// Handle Logo Selection
window.handleLogoSelect = function(event) {
    const file = event.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
            const canvas = document.createElement('canvas');
            const MAX_WIDTH = 300;
            let scaleSize = 1;
            if(img.width > MAX_WIDTH) {
                scaleSize = MAX_WIDTH / img.width;
            }
            canvas.width = img.width * scaleSize;
            canvas.height = img.height * scaleSize;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
            currentLogoBase64 = canvas.toDataURL('image/png', 0.8);
            
            const preview = document.getElementById('logo-preview');
            if (preview) {
                preview.src = currentLogoBase64;
                preview.classList.remove('hidden');
            }
        };
        img.src = e.target.result;
    };
    reader.readAsDataURL(file);
};

async function saveSettings() {
    const btn = document.getElementById('save-settings-btn');
    if(!btn) return;
    btn.disabled = true;
    btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> সেভ হচ্ছে...`;

    const smsNew = document.getElementById('set-sms-new-bill')?.value.trim() || '';
    const smsPaid = document.getElementById('set-sms-payment')?.value.trim() || '';
    const smsRem = document.getElementById('set-sms-reminder')?.value.trim() || '';

    if(smsNew.length > 155 || smsPaid.length > 155 || smsRem.length > 155) {
        Swal.fire('Error', 'SMS টেমপ্লেট ১৫৫ ক্যারেক্টারের বেশি হতে পারবে না।', 'error');
        btn.disabled = false;
        btn.innerHTML = `<i class="fa-solid fa-floppy-disk"></i> সকল সেটিংস সেভ করুন`;
        return;
    }

    const adminPinVal = document.getElementById('set-admin-pin')?.value.trim() || '1060';

    const data = {
        shopName: document.getElementById('set-shop-name')?.value.trim() || '',
        shopPhone: document.getElementById('set-shop-phone')?.value.trim() || '',
        shopAddress: document.getElementById('set-shop-address')?.value.trim() || '',
        printSize: document.getElementById('set-print-size')?.value || 'a4',
        shopLogo: currentLogoBase64,
        smsTemplateNew: smsNew,
        smsTemplatePaid: smsPaid,
        smsTemplateReminder: smsRem,
        smsApiKey: document.getElementById('set-sms-api')?.value.trim() || '',
        smsSenderId: document.getElementById('set-sms-sender')?.value.trim() || '',
        smsAuto: document.getElementById('set-sms-auto')?.checked || false,
        showWatermark: document.getElementById('set-show-watermark')?.checked || false,
        adminSecurityPin: adminPinVal,
        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
    };

    try {
        await SettingsDAO.updateAppSettings(data);
        
        // Audit Log
        auditLog('UPDATE', 'Settings', 'appSettings', 'App Settings', {
            shopName: data.shopName,
            smsAuto: data.smsAuto
        });

        const fieldsToLock = [
            'set-shop-name', 'set-shop-phone', 'set-shop-address', 'set-shop-logo', 'set-print-size', 'set-show-watermark',
            'set-sms-new-bill', 'set-sms-payment', 'set-sms-reminder', 'set-sms-api', 'set-sms-sender', 'set-sms-auto'
        ];
        fieldsToLock.forEach(id => {
            const el = document.getElementById(id);
            if(el) {
                el.disabled = true;
                el.style.opacity = '0.7';
            }
        });

        Swal.fire({
            title: 'সফল! ✅',
            text: 'সকল সেটিংস সফলভাবে ফায়ারবেসে সেভ হয়েছে।',
            icon: 'success',
            customClass: { popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700' }
        });
    } catch(error) {
        console.error("Error saving settings:", error);
        Swal.fire({
            title: 'Error! ❌',
            html: `<p style="color:#ef4444">সেটিংস সেভ করতে সমস্যা হয়েছে।</p><p style="color:#94a3b8;font-size:12px;margin-top:8px">${error.message || error}</p>`,
            icon: 'error',
            customClass: { popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700' }
        });
    } finally {
        btn.disabled = false;
        btn.innerHTML = `<i class="fa-solid fa-floppy-disk"></i> সকল সেটিংস সেভ করুন`;
    }
}

async function exportDatabase() {
    if (window.AppState.currentUserRole !== 'Admin') return;

    const isPinValid = await promptSecurityPin("ডেটাবেস ব্যাকআপ ডাউনলোড (Database Export)");
    if (!isPinValid) return;

    try {
        Swal.fire({ title: 'ব্যাকআপ জেনারেট হচ্ছে...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

        // This logic should ideally call a utility from excel_sync.js or similar
        // For now, redirecting to the standard backup function
        if (window.downloadAdminExcelBackup) {
            await window.downloadAdminExcelBackup();
        } else {
            throw new Error("Backup utility not found");
        }
    } catch(err) {
        console.error(err);
        Swal.fire('Error', 'ব্যাকআপ নিতে সমস্যা হয়েছে', 'error');
    }
}

window.saveSettings = saveSettings;
window.appSettings = { exportData: exportDatabase };

window.unlockShopSettings = async function() {
    if (window.AppState.currentUserRole !== 'Admin') {
        return Swal.fire('অ্যাক্সেস ডিনাইড!', 'শুধুমাত্র অ্যাডমিন সেটিংস পরিবর্তন করতে পারবেন।', 'error');
    }

    const isPinValid = await promptSecurityPin("দোকানের তথ্য পরিবর্তন (Settings Unlock)");
    if (!isPinValid) return;

    const fields = ['set-shop-name', 'set-shop-phone', 'set-shop-address', 'set-shop-logo', 'set-print-size', 'set-show-watermark'];
    fields.forEach(id => {
        const el = document.getElementById(id);
        if(el) {
            el.disabled = false;
            el.style.opacity = '1';
        }
    });

    Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'success',
        title: 'সেটিংস আনলক করা হয়েছে ✅',
        text: 'এখন আপনি তথ্য পরিবর্তন করতে পারবেন।',
        showConfirmButton: false,
        timer: 3000,
        customClass: { popup: '!bg-slate-900 !text-white border border-slate-700' }
    });
};

