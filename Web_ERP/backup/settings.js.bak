window.sendTestSMS = async function() {
    const apiKey = document.getElementById('set-sms-api')?.value.trim();
    const senderId = document.getElementById('set-sms-sender')?.value.trim();
    
    if (!apiKey) {
        return Swal.fire({
            title: 'API Key প্রয়োজন!',
            text: 'প্রথমে SMS Settings-এ আপনার BulkSMSBD API Key দিন এবং সেভ করুন।',
            icon: 'warning',
            customClass: { popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700' }
        });
    }

    const { value: testPhone } = await Swal.fire({
        title: '📱 টেস্ট SMS পাঠান (BulkSMSBD)',
        html: `<p style="color:#94a3b8;font-size:13px;margin-bottom:12px;">টেস্ট করার জন্য আপনার একটি 11-ডিজিটের মোবাইল নম্বর দিন (যেমন: 01819397669)</p>`,
        input: 'text',
        inputPlaceholder: '018XXXXXXXX',
        showCancelButton: true,
        confirmButtonText: 'SMS পাঠান',
        cancelButtonText: 'বাতিল',
        confirmButtonColor: '#9333ea',
        customClass: {
            popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700',
            title: '!text-white',
            confirmButton: 'm3-btn-primary !bg-purple-600',
            cancelButton: 'm3-btn-tonal'
        },
        inputValidator: (val) => {
            if (!val || val.trim().length < 11) {
                return 'সঠিক ১১-ডিজিটের মোবাইল নম্বর দিন!';
            }
        }
    });

    if (testPhone) {
        Swal.fire({
            title: 'SMS পাঠানো হচ্ছে...',
            text: 'অনুগ্রহ করে অপেক্ষা করুন',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); },
            customClass: { popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700' }
        });

        const testMsg = `MAA ERP Test SMS: Your BulkSMSBD SMS Gateway is working perfectly! - Maa Motors`;
        const res = await sendSMS(testPhone.trim(), testMsg, false);

        if (res) {
            Swal.fire({
                title: '✅ টেস্ট SMS পাঠানো হয়েছে!',
                text: `${testPhone} নম্বরে টেস্ট মেসেজ ডিসপ্যাচ করা হয়েছে। আপনার মোবাইল মেসেজ বক্সে চেক করুন।`,
                icon: 'success',
                customClass: { popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700' }
            });
        } else {
            Swal.fire({
                title: '❌ SMS পাঠাতে সমস্যা হয়েছে!',
                text: 'API Key বা Sender ID সঠিক রয়েছে কিনা এবং বাল্ক এসএমএস অ্যাকাউন্টে পর্যাপ্ত ব্যালেন্স আছে কিনা চেক করুন।',
                icon: 'error',
                customClass: { popup: '!bg-slate-900 !text-white !rounded-3xl border border-slate-700' }
            });
        }
    }
};
